# PaperIntel environment configuration example.
# Copy to .env and fill in real values. NEVER commit .env.

# --- Core ---
PAPERINTEL_ENV=dev
PAPERINTEL_DATA_DIR=./data
PAPERINTEL_LOG_LEVEL=INFO

# --- Database (PostgreSQL 16 + pgvector) ---
DATABASE_URL=postgresql+psycopg://paperintel:paperintel@127.0.0.1:5432/paperintel

# --- Redis / Celery ---
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# --- API ---
API_HOST=127.0.0.1
API_PORT=8420
API_TOKEN=

# --- LLM provider (OpenAI-compatible) ---
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_ANALYST_MODEL=analyst-model
LLM_VERIFIER_MODEL=verifier-model
LLM_SYNTH_MODEL=synth-model

# --- OCR provider (Paddle OCR HTTP) ---
PADDLE_OCR_BASE_URL=http://127.0.0.1:8866
PADDLE_OCR_API_KEY=

# --- Embedding provider (optional) ---
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# --- Disk policy ---
DISK_WARNING_FREE_PERCENT=15
DISK_CRITICAL_FREE_PERCENT=5

# Built frontend and provider configuration (paths relative to akasha_core).
PAPERINTEL_WEB_DIST=../akasha_core_front/apps/web/dist
PAPERINTEL_PROVIDERS_FILE=./config/providers.yaml
